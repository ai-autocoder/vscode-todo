// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Extension",
			"type": "extensionHost",
			"request": "launch",
			"args": [
				"--extensionDevelopmentPath=${workspaceFolder}","--disable-extensions"
			],
			"outFiles": [
				"${workspaceFolder}/out/**/*.js"
			],
			"preLaunchTask": "${defaultBuildTask}"
		}
		// There is deliberately no "Extension Tests" configuration. The suites run through
		// @vscode/test-cli — `npm test`, driven by .vscode-test.mjs — which supplies its own
		// runner. The configuration that used to sit here pointed `--extensionTestsPath` at
		// `out/test/suite/index`, a module this repo has never contained, so pressing F5 on it
		// only ever produced MODULE_NOT_FOUND. To debug a suite, install the "Extension Test
		// Runner" extension, which reads .vscode-test.mjs and lets you run or debug individual
		// tests from the Test Explorer.
	]
}
