# The service worker and its manifest must never be served stale, or clients pin to an old
# build forever. Hashed assets are immutable and can be cached hard.
/ngsw-worker.js
  Cache-Control: no-cache
/ngsw.json
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# The Content-Security-Policy is a meta tag in index.pwa.html; these two can only be sent as
# headers. No other site may frame the app, and no window that opens it, or that it opens, keeps
# a handle to post messages to it.
/*
  Content-Security-Policy: frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
