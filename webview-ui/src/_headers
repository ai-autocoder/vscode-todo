# The service worker, its manifest, the web manifest and the app shell must never be served
# stale, or clients pin to an old build. Pages' default for every file, hashed bundles included,
# is max-age=0, must-revalidate, which already revalidates; these rules keep the four that matter
# from resting on it. A rule matches the request path, and Pages answers /index.html with a 308
# to /, so the shell's rule is on /. That is also the copy the service worker keeps: it follows
# the redirect, then fetches / again and caches that without checking its hash.
/ngsw-worker.js
  Cache-Control: no-cache
/ngsw.json
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/
  Cache-Control: no-cache

# The Content-Security-Policy is a meta tag in index.pwa.html; these two can only be sent as
# headers. No other site may frame the app, and no window that opens it, or that it opens, keeps
# a handle to post messages to it.
/*
  Content-Security-Policy: frame-ancestors 'none'
  Cross-Origin-Opener-Policy: same-origin
