{
	"name": "VS Code Todo",
	"short_name": "Todo",
	"description": "Todo lists and notes synced with the VS Code Todo extension via GitHub Gist.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"orientation": "portrait",
	"background_color": "#1f1f1f",
	"theme_color": "#1f1f1f",
	"icons": [
		{
			"src": "icons/icon.svg",
			"type": "image/svg+xml",
			"sizes": "any",
			"purpose": "any"
		},
		{
			"src": "icons/icon-maskable.svg",
			"type": "image/svg+xml",
			"sizes": "any",
			"purpose": "maskable"
		}
	]
}
